				lpi_aux2_ws_active {

					mux {
						pins = "gpio11";
						function = "func1";
					};

					config {
						pins = "gpio11";
						drive-strength = <0x08>;
						bias-disable;
						output-high;
					};
				};
			};

			lpi_aux2_sd0 {

				lpi_aux2_sd0_sleep {

					mux {
						pins = "gpio12";
						function = "func2";
					};

					config {
						pins = "gpio12";
						drive-strength = <0x02>;
						bias-pull-down;
						input-enable;
					};
				};

				lpi_aux2_sd0_active {

					mux {
						pins = "gpio12";
						function = "func2";
					};

					config {
						pins = "gpio12";
						drive-strength = <0x08>;
						bias-disable;
						output-high;
					};
				};
			};

			lpi_aux2_sd1 {

				lpi_aux2_sd1_sleep {

					mux {
						pins = "gpio13";
						function = "func2";
					};

					config {
						pins = "gpio13";
						drive-strength = <0x02>;
						bias-pull-down;
						input-enable;
					};
				};

				lpi_aux2_sd1_active {

					mux {
						pins = "gpio13";
						function = "func2";
					};

					config {
						pins = "gpio13";
						drive-strength = <0x08>;
						bias-disable;
						output-high;
					};
				};
			};

			tl_tx_swr_clk_sleep: tx_swr_clk_sleep {

				mux {
					pins = "gpio0";
					function = "func1";
					input-enable;
					bias-pull-down;
				};

				config {
					pins = "gpio0";
					drive-strength = <0x02>;
				};
			};

			tl_tx_swr_clk_active: tx_swr_clk_active {

				mux {
					pins = "gpio0";
					function = "func1";
				};

				config {
					pins = "gpio0";
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-disable;
				};
			};

			tl_tx_swr_data1_sleep: tx_swr_data1_sleep {

				mux {
					pins = "gpio1";
					function = "func1";
				};

				config {
					pins = "gpio1";
					drive-strength = <0x02>;
					input-enable;
					bias-bus-hold;
				};
			};

			tl_tx_swr_data1_active: tx_swr_data1_active {

				mux {
					pins = "gpio1";
					function = "func1";
				};

				config {
					pins = "gpio1";
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-bus-hold;
				};
			};

			tl_tx_swr_data2_sleep: tx_swr_data2_sleep {

				mux {
					pins = "gpio2";
					function = "func1";
				};

				config {
					pins = "gpio2";
					drive-strength = <0x02>;
					input-enable;
					bias-pull-down;
				};
			};

			tl_tx_swr_data2_active: tx_swr_data2_active {

				mux {
					pins = "gpio2";
					function = "func1";
				};

				config {
					pins = "gpio2";
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-bus-hold;
				};
			};

			tl_rx_swr_clk_sleep: rx_swr_clk_sleep {

				mux {
					pins = "gpio3";
					function = "func1";
				};

				config {
					pins = "gpio3";
					drive-strength = <0x02>;
					input-enable;
					bias-pull-down;
				};
			};

			tl_rx_swr_clk_active: rx_swr_clk_active {

				mux {
					pins = "gpio3";
					function = "func1";
				};

				config {
					pins = "gpio3";
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-disable;
				};
			};

			tl_rx_swr_data_sleep: rx_swr_data_sleep {

				mux {
					pins = "gpio4";
					function = "func1";
				};

				config {
					pins = "gpio4";
					drive-strength = <0x02>;
					input-enable;
					bias-pull-down;
				};
			};

			tl_rx_swr_data_active: rx_swr_data_active {

				mux {
					pins = "gpio4";
					function = "func1";
				};

				config {
					pins = "gpio4";
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-bus-hold;
				};
			};

			tl_rx_swr_data1_sleep: rx_swr_data1_sleep {

				mux {
					pins = "gpio5";
					function = "func2";
				};

				config {
					pins = "gpio5";
					drive-strength = <0x02>;
					input-enable;
					bias-pull-down;
				};
			};

			tl_rx_swr_data1_active: rx_swr_data1_active {

				mux {
					pins = "gpio5";
					function = "func2";
				};

				config {
					pins = "gpio5";
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-bus-hold;
				};
			};
		};

		tl_cdc_sen_pinctrl: cdc_sen_pinctrl {
			compatible = "qcom,msm-cdc-pinctrl";
			pinctrl-names = "aud_active", "aud_sleep";
			pinctrl-0 = <&tl_lpi_i2s2_sck_active &tl_lpi_i2s2_ws_active &tl_lpi_i2s2_sd0_active>;
			pinctrl-1 = <&tl_lpi_i2s2_sck_sleep &tl_lpi_i2s2_ws_sleep &tl_lpi_i2s2_sd0_sleep>;
			qcom,lpi-gpios;
		};

		tl_rx_swr_clk_data_pinctrl: rx_swr_clk_data_pinctrl {
			compatible = "qcom,msm-cdc-pinctrl";
			pinctrl-names = "aud_active", "aud_sleep";
			pinctrl-0 = <&tl_rx_swr_clk_active &tl_rx_swr_data_active &tl_rx_swr_data1_active>;
			pinctrl-1 = <&tl_rx_swr_clk_sleep &tl_rx_swr_data_sleep &tl_rx_swr_data1_sleep>;
			qcom,lpi-gpios;
		};

		tl_tx_swr_clk_data_pinctrl: tx_swr_clk_data_pinctrl {
			compatible = "qcom,msm-cdc-pinctrl";
			pinctrl-names = "aud_active", "aud_sleep";
			pinctrl-0 = <&tl_tx_swr_clk_active &tl_tx_swr_data1_active &tl_tx_swr_data2_active>;
			pinctrl-1 = <&tl_tx_swr_clk_sleep &tl_tx_swr_data1_sleep &tl_tx_swr_data2_sleep>;
			qcom,lpi-gpios;
			qcom,tlmm-gpio = <0x93>;
		};
};

&soc {
		tl_rx_core_clk: rx_core_clk {
			compatible = "qcom,audio-ref-clk";
			qcom,codec-ext-clk-src = <0x05>;
			qcom,codec-lpass-ext-clk-freq = <0x1588800>;
			qcom,codec-lpass-clk-id = <0x30e>;
			#clock-cells = <0x01>;
		};
};

&soc {
		tl_rx_npl_clk: rx_npl_clk {
			compatible = "qcom,audio-ref-clk";
			qcom,codec-ext-clk-src = <0x06>;
			qcom,codec-lpass-ext-clk-freq = <0x1588800>;
			qcom,codec-lpass-clk-id = <0x30f>;
			#clock-cells = <0x01>;
		};
};

&soc {
