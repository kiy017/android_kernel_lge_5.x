					mux {
						pins = "gpio1";
						function = "func2";
					};

					config {
						pins = "gpio1";
						drive-strength = <0x08>;
						bias-disable;
						output-high;
					};
				};
			};

			quat_mi2s_sd0 {

				quat_mi2s_sd0_sleep {

					mux {
						pins = "gpio2";
						function = "func2";
					};

					config {
						pins = "gpio2";
						drive-strength = <0x02>;
						bias-pull-down;
						input-enable;
					};
				};

				quat_mi2s_sd0_active {

					mux {
						pins = "gpio2";
						function = "func2";
					};

					config {
						pins = "gpio2";
						drive-strength = <0x08>;
						bias-disable;
						output-high;
					};
				};
			};

			quat_mi2s_sd1 {

				quat_mi2s_sd1_sleep {

					mux {
						pins = "gpio3";
