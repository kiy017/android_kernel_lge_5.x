&qupv3_se15_i2c {
		fsa4480: fsa4480@43 {
			compatible = "qcom,fsa4480-i2c";
			reg = <0x43>;
		};
};

&qupv3_se15_i2c {
		tl_tfa98xx_34: tfa98xx@34 {
			compatible = "nxp,tfa98xx";
			status = "ok";
			reg = <0x34>;
			reset-gpio = <&tlmm 0x63 0x0>;
			reset-polarity = <0x00>;
			nxp,firmware-name = "Tfa98xx.cnt";
		};
};

&qupv3_se15_i2c {
		tl_tfa98xx_35: tfa98xx@35 {
			compatible = "nxp,tfa98xx";
			status = "ok";
			reg = <0x35>;
			nxp,firmware-name = "Tfa98xx.cnt";
		};
};

&qupv3_se15_i2c {
		tl_es9218_codec_48: es9218-codec@48 {
			compatible = "dac,es9218-codec";
			status = "ok";
			reg = <0x48>;
			dac,use-internal-ldo;
			dac,power-gpio = <&pm8150_gpios 0xa 0x0>;
			dac,hph-sw = <&pm8150_gpios 0x9 0x0>;
			dac,reset-gpio = <&tlmm 0x16 0x0>;
			/*
			 * dac,switch-gpio, dac,es9219 and the hifi_mclk clock
			 * differ per board revision: kona-timelm_common-sound_rev-b.dtsi
			 * and kona-timelm_common-sound_rev-b1.dtsi (LG
			 * kona-timelm_*-sound_rev-b{,1}.dtsi).
			 */
		};
};

